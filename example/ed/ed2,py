def xxz_sound_velocity(delta):
    """BA sound velocity in Pauli-matrix convention."""
    eta = np.arccos(delta)
    return 2.0 * np.pi * np.sin(eta) / eta


def signed_r_grid(L):
    """
    r-grid consistent with your current plot:
        r = -L/2, ..., L/2 - 1
    for even L.
    """
    if L % 2 != 0:
        raise ValueError("This helper assumes even L.")
    return np.arange(-L // 2, L // 2)


def structure_factor_time_from_correlation(correlations, q, L, *, normalize=True):
    """
    Convert C(r,t) to S(q,t):

        S(q,t) = sum_r exp(-i q r) C(r,t).

    Parameters
    ----------
    correlations:
        Complex array of shape (Nt, L).
        correlations[n, a] = C(r_a, t_n).

    q:
        Momentum.

    L:
        System size.

    normalize:
        If True, return S(q,t) / S(q,0).

    Returns
    -------
    signal:
        Complex array S(q,t).
    """
    correlations = np.asarray(correlations, dtype=np.complex128)

    if correlations.shape[1] != L:
        raise ValueError(
            f"Expected correlations.shape[1] = L = {L}, "
            f"but got {correlations.shape[1]}."
        )

    r = signed_r_grid(L)
    phase = np.exp(-1j * q * r)

    signal = correlations @ phase

    if normalize:
        if abs(signal[0]) < 1e-14:
            raise ValueError("S(q,0) is too small to normalize.")
        signal = signal / signal[0]

    return signal


def estimate_phase_frequency(tlist, signal, *, tmin=0.5, tmax=None, amp_cut=0.05):
    """
    Estimate omega from the phase of a complex signal:

        signal(t) ~ exp(-i omega t).

    Returns omega > 0.
    """
    tlist = np.asarray(tlist, dtype=float)
    signal = np.asarray(signal, dtype=np.complex128)

    phase = np.unwrap(np.angle(signal))
    amp = np.abs(signal)

    mask = tlist >= tmin

    if tmax is not None:
        mask &= tlist <= tmax

    mask &= amp > amp_cut * np.max(amp)

    if np.count_nonzero(mask) < 3:
        return np.nan, np.nan, phase, mask

    # Weighted phase fit. This is more stable when the amplitude decays.
    weights = amp[mask]
    slope, intercept = np.polyfit(
        tlist[mask],
        phase[mask],
        deg=1,
        w=weights,
    )

    omega = -slope

    return abs(float(omega)), float(intercept), phase, mask


def estimate_velocity_from_correlation_phase(
    tlist,
    correlations,
    L,
    m,
    *,
    tmin=0.5,
    tmax=None,
):
    """
    Estimate v from C(r,t) -> S(q,t) -> phase fit.
    """
    q = 2.0 * np.pi * m / L

    signal = structure_factor_time_from_correlation(
        correlations,
        q,
        L,
        normalize=True,
    )

    omega, intercept, phase, mask = estimate_phase_frequency(
        tlist,
        signal,
        tmin=tmin,
        tmax=tmax,
    )

    v = omega / q

    return {
        "m": m,
        "q": q,
        "omega": omega,
        "v": v,
        "signal": signal,
        "phase": phase,
        "mask": mask,
    }


def estimate_vs_from_many_m(
    tlist,
    correlations,
    L,
    m_list=(1, 2, 3, 4),
    *,
    tmin=0.5,
    tmax=None,
):
    """
    Estimate omega(q) for several small momenta and fit v_s.

    Uses:
        omega(q) = v q
    and also:
        omega(q) = v q + a q^3.
    """
    rows = []

    for m in m_list:
        item = estimate_velocity_from_correlation_phase(
            tlist,
            correlations,
            L,
            m,
            tmin=tmin,
            tmax=tmax,
        )
        if np.isfinite(item["omega"]):
            rows.append(item)

    qs = np.array([x["q"] for x in rows], dtype=float)
    omegas = np.array([x["omega"] for x in rows], dtype=float)

    if len(qs) == 0:
        return {
            "rows": rows,
            "qs": qs,
            "omegas": omegas,
            "v_linear": np.nan,
            "v_cubic": np.nan,
            "a_cubic": np.nan,
        }

    # Fit through origin: omega = v q.
    v_linear = np.sum(qs * omegas) / np.sum(qs ** 2)

    # Fit omega = v q + a q^3.
    if len(qs) >= 2:
        X = np.column_stack([qs, qs ** 3])
        coeff, *_ = np.linalg.lstsq(X, omegas, rcond=None)
        v_cubic = float(coeff[0])
        a_cubic = float(coeff[1])
    else:
        v_cubic = np.nan
        a_cubic = np.nan

    return {
        "rows": rows,
        "qs": qs,
        "omegas": omegas,
        "v_linear": float(v_linear),
        "v_cubic": v_cubic,
        "a_cubic": a_cubic,
    }


def plot_sqt_phase(tlist, item, *, v_ba=None):
    q = item["q"]
    signal = item["signal"]
    phase = item["phase"]
    mask = item["mask"]
    omega = item["omega"]

    fig, (ax0, ax1) = plt.subplots(2, 1, figsize=(6.5, 5.0), sharex=True)

    ax0.plot(tlist, np.real(signal), label=r"$\mathrm{Re}\,S(q,t)$")
    ax0.plot(tlist, np.imag(signal), label=r"$\mathrm{Im}\,S(q,t)$")
    ax0.set_ylabel(r"$S(q,t)/S(q,0)$")
    ax0.legend(frameon=False)

    ax1.plot(tlist, phase, label="unwrapped phase")
    ax1.plot(tlist[mask], phase[mask], ".", markersize=3, label="fit window")

    if np.isfinite(omega):
        # 简单画一条拟合斜率线，只用于看趋势
        t0 = tlist[mask][0]
        p0 = phase[mask][0]
        ax1.plot(
            tlist,
            p0 - omega * (tlist - t0),
            "--",
            label=fr"fit $\omega={omega:.4f}$",
        )

    if v_ba is not None:
        ax1.plot(
            tlist,
            phase[0] - v_ba * q * tlist,
            ":",
            label=fr"BA $\omega=vq={v_ba*q:.4f}$",
        )

    ax1.set_xlabel(r"$t$")
    ax1.set_ylabel(r"$\arg S(q,t)$")
    ax1.legend(frameon=False)

    fig.tight_layout()
    plt.show()

